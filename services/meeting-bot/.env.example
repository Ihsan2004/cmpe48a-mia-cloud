NODE_ENV=development

# Chrome executable path (Docker default: /usr/bin/google-chrome)
# For macOS local dev, use Playwright's Chromium:
# CHROME_PATH=/Users/<you>/Library/Caches/ms-playwright/chromium-1124/chrome-mac/Chromium.app/Contents/MacOS/Chromium
# CHROME_PATH=

# Mia backend configuration
MIA_BACKEND_URL=http://host.docker.internal:8080
MIA_BOT_API_KEY=
MIA_BACKEND_SIGNALS_ENABLED=true
MIA_HEARTBEAT_INTERVAL_MS=30000

# Meeting recording configuration
MAX_RECORDING_DURATION_MINUTES=180
# Silence detection timeout in minutes (how long to wait before ending due to inactivity)
MEETING_INACTIVITY_MINUTES=2
INACTIVITY_DETECTION_START_DELAY_MINUTES=5
# How long to wait at lobby before timing out (in minutes)
JOIN_WAIT_TIME_MINUTES=2
# Number of retries for transient errors (WaitingAtLobbyRetryError never retries)
# RETRY_COUNT=2 means: 1 initial attempt + 2 retries = 3 total attempts
RETRY_COUNT=2

# Redis
REDIS_CONSUMER_ENABLED=false
REDIS_QUEUE_NAME=jobs:meetbot:list
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Uploader
UPLOADER_FILE_EXTENSION=.webm

# Storage provider selection: 's3' (default) or 'azure'
STORAGE_PROVIDER=s3

# S3 compatible storage for recording upload
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_USE_MINIO_COMPATIBILITY=false

# Azure Blob Storage (when STORAGE_PROVIDER=azure)
# Provide ONE of the following auth methods:
# 1. Connection string
AZURE_STORAGE_CONNECTION_STRING=
# 2. Account + Key
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
# 3. Account + SAS Token (starts with ?sv=)
AZURE_STORAGE_SAS_TOKEN=
# 4. Managed Identity (requires AZURE_STORAGE_ACCOUNT)
AZURE_USE_MANAGED_IDENTITY=false
# Required for Azure
AZURE_STORAGE_CONTAINER=
# Optional Azure settings
AZURE_BLOB_PREFIX=
AZURE_SIGNED_URL_TTL_SECONDS=3600
AZURE_UPLOAD_CONCURRENCY=4

# Notification service (optional) - triggers after recording upload completes
# Webhook notifications
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# Redis list notifications (for async job processing)
NOTIFY_REDIS_ENABLED=false
NOTIFY_REDIS_URI=
NOTIFY_REDIS_DB=1
NOTIFY_REDIS_LIST=jobs:meetbot:recordings

# STT pipeline (real-time transcription)
STT_ENABLED=false
PCM_CHUNK_MS=200
# PulseAudio monitor device for Teams audio capture (Docker only)
# PULSE_MONITOR_DEVICE=virtual_output.monitor
# Debug: dump raw PCM to dist/_pcm_debug/ for ffplay verification
# STT_DEBUG_PCM_DUMP=true

# ElevenLabs Scribe v2 Realtime (requires STT_ENABLED=true)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL_ID=scribe_v2_realtime
# ELEVENLABS_REGION=         # '' = global, 'us', 'eu', 'in'
# STT_COMMIT_STRATEGY=manual # 'manual' or 'vad'
# STT_LANGUAGE=              # '' = auto-detect, 'tr', 'en', etc.

# Transcript DB writer (requires STT_ENABLED=true)
TRANSCRIPT_WRITE_ENABLED=false
DATABASE_URL=
# DATABASE_SSL=true          # default true (Supabase), set false for local PG

# VAD — Voice Activity Detection (requires STT_ENABLED=true)
# Filters silence before sending to STT — saves ~46% ElevenLabs cost
VAD_ENABLED=false
# VAD_WEBRTC_AGGRESSIVENESS=2    # 0=least, 3=most aggressive
# VAD_SILERO_THRESHOLD=0.5       # Silero speech probability threshold (0-1)
# VAD_UTTERANCE_TAIL_MS=600      # Silence duration to mark utterance end
# VAD_PENDING_FRAME_LOOKBACK=true # Keep last silence frame to preserve first syllable

# Audio Processing — NoiseGate + AGC (requires STT_ENABLED=true)
# Each can be enabled independently
NOISE_GATE_ENABLED=false
# NOISE_GATE_THRESHOLD_DB=-40     # dB threshold, below = silence
AGC_ENABLED=false
# AGC_TARGET_RMS=0.1              # Target RMS level (0-1)
# AGC_MAX_GAIN=3.0                # Max amplification factor

# Authenticated join (optional — leave empty for guest join)
# When set, bot will sign in with these credentials if the meeting requires authentication
# Works for both Google Meet (accounts.google.com) and Microsoft Teams (login.microsoftonline.com)
# NOTE: 2FA/MFA must be disabled on this account (or use App Password)
BOT_AUTH_EMAIL=
BOT_AUTH_PASSWORD=

# Active Speaker Detection (Faz 6) — DOM-based speaker identification
# Detects who is speaking via browser DOM signals (participants panel, video tiles)
ACTIVE_SPEAKER_ENABLED=false
# SPEAKER_POLLING_INTERVAL_MS=300  # DOM polling interval (ms)
# SPEAKER_SWITCH_DELAY_MS=800      # Hysteresis: min time before switching speaker (ms)
