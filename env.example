# ==================== Database Configuration ====================
# Local Docker Compose uses pgvector/pgvector:pg16; GCP uses Cloud SQL (PostgreSQL 16 + pgvector)
POSTGRES_USER=mia
POSTGRES_PASSWORD=mia_local_password_change_me
POSTGRES_DB=mia
DATABASE_URL=postgresql://mia:mia_local_password_change_me@postgres:5432/mia?sslmode=disable
DATABASE_SSL=false

# ==================== Authentication ====================
# JWT Authentication (access tokens; refresh tokens are opaque DB tokens)
JWT_SECRET=your-secure-jwt-secret-key-minimum-32-characters-long

# Google OAuth (optional — email/password signup & signin work without this)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ==================== API & Frontend ====================
VITE_API_URL=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:3000
PORT=8080

# ==================== Internal Service Routing ====================
# Docker Compose defaults (override on GCP GKE/VM/Cloud Functions)
NLP_SERVICE_URL=http://mia-search:8000
EXTERNAL_BOT_API_URL=http://meeting-bot:3000
MIA_BACKEND_URL=http://mia-backend:8080
BRIEF_NOTIFIER_FUNCTION_URL=http://brief-notifier:8080

# Shared secrets between internal services (change for production!)
INTERNAL_SERVICE_SHARED_SECRET=change-me-to-a-long-random-secret
MIA_BOT_API_KEY=change-me-bot-api-key

# Google Calendar webhook URL (optional)
WEBHOOK_BASE_URL=

# ==================== Real-Time STT & AI / LLM ====================
# ElevenLabs Realtime WebSocket STT (used by meeting-bot)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2_realtime
STT_LANGUAGE=tr
LEGACY_BOT_COMPLETION_TRIGGER=true

# OpenAI (transcript correction, summarization, extraction, embeddings)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==================== Optional Notifications (SMTP / Cloud Function) ====================
UNSUBSCRIBE_SIGNING_SECRET=change-me-unsubscribe-secret-32-chars-min
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MIA Meeting Assistant
