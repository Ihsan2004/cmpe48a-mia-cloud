# ==================== Database Configuration ====================

# Google Cloud SQL (PostgreSQL + pgvector)
DATABASE_URL=postgresql://mia_user:YOUR_DB_PASSWORD@127.0.0.1:5432/mia?sslmode=disable

# Optional legacy Supabase configuration (replaced by Cloud SQL in GCP architecture)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AUDIO_BUCKET=meeting-audio

# ==================== Authentication ====================

# JWT Authentication (access tokens only — refresh tokens are opaque)
JWT_SECRET=your-secure-jwt-secret-key-minimum-32-characters-long

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ==================== API Configuration ====================

VITE_API_URL=http://localhost:8080/api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:3000
PORT=8080

# ==================== External Services ====================

# Meeting bot API (joins meetings and records transcripts)
EXTERNAL_BOT_API_URL=http://your-bot-api-url

# NLP Service URL (mia-search)
# Docker: http://mia-search:8000 | Local: http://localhost:8000
NLP_SERVICE_URL=http://mia-search:8000

# Internal service auth (Go backend <-> mia-search)
INTERNAL_SERVICE_SHARED_SECRET=change-me-to-a-long-random-secret

# Google Calendar webhook URL (for real-time sync)
# Local dev: use ngrok (ngrok http 8080)
WEBHOOK_BASE_URL=

# ==================== AI / LLM ====================

# OpenAI (correction + summary via mia-search)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Real-time Bot STT Trigger & Cloud Function Integration
LEGACY_BOT_COMPLETION_TRIGGER=true
BRIEF_NOTIFIER_FUNCTION_URL=

# ElevenLabs (used by meeting-bot via Scribe v2 Realtime WebSocket)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=scribe_v2_realtime
ELEVENLABS_LANGUAGE=tr

# ==================== Email (SMTP) ====================

# Auth emails: password reset, onboarding
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MIA Meeting Assistant
